FROM public.ecr.aws/lambda/python:3.12

COPY requirements.txt ${LAMBDA_TASK_ROOT}
RUN pip install --no-cache-dir -r requirements.txt

COPY . ${LAMBDA_TASK_ROOT}

RUN find ${LAMBDA_TASK_ROOT} -name "*.pyc" -delete && \
    find ${LAMBDA_TASK_ROOT} -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf ${LAMBDA_TASK_ROOT}/.git ${LAMBDA_TASK_ROOT}/tests ${LAMBDA_TASK_ROOT}/.venv 2>/dev/null || true

RUN mkdir -p /asset && \
    cp -r ${LAMBDA_TASK_ROOT}/* /asset/ 2>/dev/null || true

CMD ["entrypoint.lambda_handler"]